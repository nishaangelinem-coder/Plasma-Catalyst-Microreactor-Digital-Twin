;; =============================================================================
;; cfet_common.ocn -- shared OCEAN setup for the CFET multi-material flow.
;; Loaded by every other .ocn in this directory:
;;     load(strcat(getShellEnvVar("CFET_ROOT") "/cadence/ocean/cfet_common.ocn"))
;;
;; Provides
;;   CFET_ROOT, CFET_LIB_NAME, CFET_RESULTS, CFET_PSF          paths
;;   cfetPlatforms, cfetDevices                                platform table
;;   cfetSelectedPlatforms() / cfetSelectedDevices()           CFET_PLATFORM /
;;                                                             CFET_DEVICE filter
;;   cfetSetup(tbCell plat tag)                                simulator/design/
;;                                                             resultsDir/desVars/temp
;;   cfetWriteCSV(path xName colSpecs)                         waveform table -> CSV
;;   cfetAppendRow(path header values)                         scalar row -> CSV
;;   cfetIdWave(pol)                                           drain current wave
;;
;; Verilog-A: in cellview mode (default) the `veriloga` views of CFET_LIB are
;; netlisted by ADE itself, i.e. no ahdlInclude is needed. If you prefer the
;; hand-written netlists, set CFET_USE_NETLIST = t before loading: design()
;; then points to netlists/spectre/<tb>.scs, whose `ahdl_include` lines pull the
;; .va sources (comment out the analyses in the .scs first; OCEAN adds its own).
;; =============================================================================

CFET_ROOT = getShellEnvVar("CFET_ROOT") ||
            strcat(getShellEnvVar("HOME")
                   "/Plasma-Catalyst-Microreactor-Digital-Twin/cfet_multimaterial")
CFET_LIB_NAME = "CFET_LIB"
CFET_RESULTS  = strcat(CFET_ROOT "/results")
CFET_PSF      = strcat(CFET_ROOT "/cadence/work/psf")
unless(boundp('CFET_USE_NETLIST) CFET_USE_NETLIST = nil)
unless(boundp('CFET_PLATFORM)    CFET_PLATFORM = nil)   ; e.g. "si"  or list("si" "gan")
unless(boundp('CFET_DEVICE)      CFET_DEVICE   = nil)   ; e.g. "gaa_n"

;; shell overrides:  CFET_PLATFORM=tmd ocean -nograph -restore idvg.ocn
when(getShellEnvVar("CFET_PLATFORM") CFET_PLATFORM = getShellEnvVar("CFET_PLATFORM"))
when(getShellEnvVar("CFET_DEVICE")   CFET_DEVICE   = getShellEnvVar("CFET_DEVICE"))

procedure(cfetMsg(fmt @rest args)
  printf("[cfet] %s\n" apply('sprintf cons(nil cons(fmt args)))))


;; (cell platformName polarity)
cfetDevices = list(
  list("gaa_n"  "si"   "n") list("gaa_p" "si"  "p") list("sige_p" "sige" "p")
  list("mos2_n" "tmd"  "n") list("wse2_p" "tmd" "p")
  list("cnt_n"  "cnt"  "n") list("cnt_p" "cnt" "p")
  list("gan_n"  "gan"  "n") list("gan_p" "gan" "p"))

procedure(cfetPlatform(name) car(exists(p cfetPlatforms p->name == name)))

procedure(cfetSelectedPlatforms()
  cond(
    (null(CFET_PLATFORM) cfetPlatforms)
    (stringp(CFET_PLATFORM) list(cfetPlatform(CFET_PLATFORM)))
    (t mapcar('cfetPlatform CFET_PLATFORM))))

procedure(cfetSelectedDevices()
  if(CFET_DEVICE
     list(assoc(CFET_DEVICE cfetDevices))
     cfetDevices))

procedure(cfetDesVar(plat name) cadr(assoc(name plat->desVars)))

;; ---------------------------------------------------------------------------
;; Simulation setup
;; ---------------------------------------------------------------------------
;; cfetSetup(tbCell plat tag): selects Spectre, the testbench cellview (or the
;; equivalent hand-written netlist), a unique resultsDir per run, all design
;; variables of the platform and the temperature.
procedure(cfetSetup(tbCell plat tag)
  simulator('spectre)
  if(CFET_USE_NETLIST
    design(strcat(CFET_ROOT "/netlists/spectre/" tbCell ".scs"))
    design(CFET_LIB_NAME tbCell "schematic"))
  resultsDir(strcat(CFET_PSF "/" tbCell "_" tag))
  ;; ahdlInclude is NOT needed in cellview mode: the veriloga views are
  ;; netlisted automatically. In netlist mode the .scs carries ahdl_include.
  foreach(dv plat->desVars desVar(car(dv) cadr(dv)))
  temp(cfetDesVar(plat "TEMP"))
  ;; accuracy options recommended for ring oscillators and sharp VTCs
  option('reltol 1e-4 'vabstol 1e-7 'iabstol 1e-13 'gmin 1e-15)
  t)

;; Drain-current wave of the device testbench (see build_schematics.il):
;; n-type: current leaves VD:PLUS into the drain -> Id = -I(VD:PLUS)
;; p-type: VD = -VDS, current flows from source through the device into VD:PLUS
procedure(cfetIdWave(pol)
  if(pol == "n" minus(i("/VD/PLUS")) i("/VD/PLUS")))

;; ---------------------------------------------------------------------------
;; CSV export helpers
;; ---------------------------------------------------------------------------
;; cfetWriteCSV("file.csv" "VGS" list(list("ID_lin" wave1) list("ID_sat" wave2)))
;; Uses the documented dr* vector API (drGetWaveformXVec / drGetWaveformYVec /
;; drVectorLength / drGetElem). All waves must share the same x vector (same
;; sweep). ocnPrint(?output file ...) is the simpler, space-separated fallback.
procedure(cfetWriteCSV(path xName colSpecs)
  let((op xv yvs n)
    createDirHier(cfetDirName(path))
    op = outfile(path "w")
    unless(op error("cfetWriteCSV: cannot open %s" path))
    fprintf(op "%s" xName)
    foreach(c colSpecs fprintf(op ",%s" car(c)))
    fprintf(op "\n")
    xv  = drGetWaveformXVec(cadr(car(colSpecs)))
    yvs = foreach(mapcar c colSpecs drGetWaveformYVec(cadr(c)))
    n   = drVectorLength(xv)
    for(k 0 n - 1
      fprintf(op "%.9g" drGetElem(xv k))
      foreach(yv yvs fprintf(op ",%.9g" drGetElem(yv k)))
      fprintf(op "\n"))
    close(op)
    cfetMsg("wrote %s (%d rows)" path n)
    path))

;; Scalar table: header written once, one row appended per call.
procedure(cfetAppendRow(path header values)
  let((op new)
    createDirHier(cfetDirName(path))
    new = !isFile(path)
    op = outfile(path "a")
    when(new fprintf(op "%s\n" buildString(header ",")))
    fprintf(op "%s\n" buildString(foreach(mapcar v values
                                   if(stringp(v) v sprintf(nil "%.9g" v))) ","))
    close(op)
    path))

procedure(cfetDirName(path)
  let((parts)
    parts = parseString(path "/")
    strcat("/" buildString(reverse(cdr(reverse(parts))) "/"))))

;; Space-separated fallback export (several waves, same sweep)
procedure(cfetOcnPrint(path @rest waves)
  createDirHier(cfetDirName(path))
  apply('ocnPrint append(list(?output path ?numberNotation 'scientific ?numSpaces 1) waves)))

;; ---------------------------------------------------------------------------
;; Ring-oscillator FoM from waveforms (shared by ro_tran / vdd_sweep /
;; temp_sweep / sensitivity_* / montecarlo)
;;   returns list(fRO tpd Pavg Ecycle PDP); zeros when < 11 cycles were found
;; ---------------------------------------------------------------------------
procedure(cfetRoFomFromWaves(vout pvdd vdd n)
  let((t10 t11 fro tpd pavg)
    t10 = cross(vout vdd / 2 10 "rising")
    t11 = cross(vout vdd / 2 11 "rising")
    if(t10 && t11
      progn(
        fro  = 1.0 / (t11 - t10)
        tpd  = 1.0 / (2.0 * n * fro)
        pavg = average(clip(pvdd t10 xmax(vout)))
        list(fro tpd pavg pavg / fro pavg * tpd))
      list(0 0 0 0 0))))

;; Run the RO testbench of a platform at the current design variables and
;; return list(fRO tpd Pavg Ecycle PDP). `tag` makes the resultsDir unique.
procedure(cfetRunRoPoint(plat tag @optional overrides)
  let((n tb vdd)
    n   = plat->stages
    vdd = plat->vdd
    tb  = sprintf(nil "tb_ro%d_cfet_%s" n plat->name)
    cfetSetup(tb plat tag)
    foreach(o overrides
      if(car(o) == "TEMP" temp(cadr(o)))
      desVar(car(o) cadr(o))
      when(car(o) == "VDD" vdd = cadr(o)))
    analysis('tran ?stop plat->roStop ?maxstep plat->roMaxstep ?errpreset 'conservative)
    save('v "/out") save('i "/VDD/PLUS")
    ic("/out" 0.0)
    run()
    selectResult('tran)
    cfetRoFomFromWaves(v("/out") vdd * minus(i("/VDD/PLUS")) vdd n)))

createDirHier(CFET_RESULTS)
createDirHier(CFET_PSF)
cfetMsg("cfet_common.ocn loaded; CFET_ROOT=%s platforms=%L" CFET_ROOT
        foreach(mapcar p cfetSelectedPlatforms() p->name))

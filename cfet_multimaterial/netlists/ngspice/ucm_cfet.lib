* ucm_cfet.lib -- ngspice behavioural implementation of the UCM-CFET models
* generated 2026-10-05 by sim/ngspice_lib.py from sim/platforms.py (+ data/calibrated_params.json if present)
* Equations identical to veriloga/*.va ; see doc/model_spec.md

* -------------------------------------------------------------------------------------
* gaa_n: UCM-CFET Si nanosheet n-FET  (platform Si, dd)
* terminals d g s b ; TYPE = 1
* -------------------------------------------------------------------------------------
.subckt gaa_n d g s b W=1e-07 L=1.6e-08 NNS=3.0 WNS=2e-08 TNS=5e-09 VTH0=0.34564595563211264 N0=1.1421153845705354 ETA=0.04584877940688493 MU0=0.007528408507140861 COX=0.043 VSAT=249999.99999999994 LAMBDA=0.29999999999941973 RSW=5.313652472144767e-05 RDW=5.313652472144767e-05 CGSO=3e-10 CGDO=3e-10 TNOM=300.0 MUEXP=1.3 KVTH=-0.0008 CQ=1.0e9 DIT=0.0 RC=0.0 RTH=0.0 CTH=1e-12 DCNT=0.0 FMET=0.0 TTR=0.0 ALPHA=1.0 TEMPK=300.15
.param TYPE=1
.param G0=0.00015496183459727297
.param QE=1.602176634e-19 KBOLTZ=1.380649e-23
.func sp(x) {x > 40 ? x : ln(1 + exp(x))}
.func sabs(x) {sqrt(x*x + 1e-6)}
.func weff() {NNS > 0 ? NNS*2*(WNS + TNS) : W}
.func vt(td) {KBOLTZ*td/QE}
.func coxeff() {COX*CQ/(COX + CQ)}
.func nid() {N0*(1 + QE*DIT/COX)}
.func vtht(td) {VTH0 + KVTH*(td - TNOM)}
.func vtheff(vds,td) {vtht(td) - ETA*sabs(vds)}
.func mut(td) {MU0 > 0 ? MU0*pow(td/TNOM, -MUEXP) : 1}
* charge function (own-branch voltage only)
.func qg(v,td) {0.5*weff()*L*coxeff()*2*nid()*vt(td)*sp((v - vtht(td))/(2*nid()*vt(td)))}
* series resistances (floored at 1 mOhm for the solver)
Rd d di R={(RDW/weff()) > 1e-3 ? RDW/weff() : 1e-3}
Rs s si R={(RSW/weff()) > 1e-3 ? RSW/weff() : 1e-3}
* drift-diffusion + velocity saturation, n-type convention; Vov and Vdsat on auxiliary nodes
Bvov vov 0 V = 2*nid()*vt((TEMPK + V(tj)))*sp(((TYPE*V(g,si)) - vtheff((TYPE*V(di,si)),(TEMPK + V(tj))))/(2*nid()*vt((TEMPK + V(tj)))))
Bvdsat vdsat 0 V = V(vov)/(1 + V(vov)/(VSAT*L/mut((TEMPK + V(tj)))))
Bids di dx I = TYPE*mut((TEMPK + V(tj)))*coxeff()*weff()/L*V(vov)*V(vov)/(2*(1 + V(vov)/(VSAT*L/mut((TEMPK + V(tj))))))*tanh(2*(TYPE*V(di,si))/(V(vdsat) + 1e-9))*(1 + LAMBDA*sabs((TYPE*V(di,si))))
Vsns dx si 0
* terminal charges  Qg = Qgs + Qgd ; Qs = -Qgs ; Qd = -Qgd
Cgs g si Q = TYPE*(qg((TYPE*V(g,si)), (TEMPK + V(tj))) + CGSO*weff()*(TYPE*V(g,si)))
Cgd g di Q = TYPE*(qg(TYPE*V(g,di), (TEMPK + V(tj))) + CGDO*weff()*TYPE*V(g,di))
* self-heating thermal node (temperature rise in volts == kelvin); RTH=0 -> node held at 0
Bpd tj 0 I = -(RTH > 0 ? 1 : 0)*TYPE*i(Vsns)*(TYPE*V(di,si))
Rth tj 0 R={RTH > 0 ? RTH : 1e-3}
Cth tj 0 {CTH}
* body: reference only
Rb b si 1e12
.ends gaa_n


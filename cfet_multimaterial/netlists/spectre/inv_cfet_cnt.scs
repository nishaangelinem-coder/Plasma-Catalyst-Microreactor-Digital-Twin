// =============================================================================
// inv_cfet_cnt.scs
// CFET-CNT CFET inverter sub-circuit: cnt_p stacked over cnt_n + CFET parasitics
// Hand-written Spectre netlist equivalent to CFET_LIB/inv_cfet_cnt/schematic
// (cadence/skill/build_schematics.il). Included by tb_inv_cfet_cnt.scs and ro5_cfet_cnt.scs
// (not a top-level netlist: it carries no analyses and no top-level parameters).
// Units: SI throughout (m, V, A, F, Ohm; RSW/RDW/RC in Ohm*m, DIT in m^-2 eV^-1,
// DCNT in tubes/m, RTH in K/W, CTH in J/K). Suffixes: f=1e-15 p=1e-12 n=1e-9 u=1e-6.
// =============================================================================
simulator lang=spectre
global 0

// ---- compact models -----------------------------------------------------------
ahdl_include "../../veriloga/cnt_n.va"
ahdl_include "../../veriloga/cnt_p.va"

// NOTE: no top-level `parameters` here -- the including testbench defines the
// design variables (Wn=100n Wp=100n Lg=15n VTHN=0.20 VTHP=0.22 DCNT=250e6 FMET=0.01 RCN=1e-4 RCP=1e-4)
// and passes them to every instance; duplicate top-level definitions would be
// rejected by Spectre.

// -------------------------------------------------------------------------------
// inv_cfet_cnt (in out vdd vss)
//
//            vdd ---- s,b  MP (cnt_p)  d ---- pd ---[Rlocal_p]---+
//   in ---- g                                                        |-- out --[Cout]-- vss
//            vss ---- s,b  MN (cnt_n)  d ---- nd ---[Rlocal_n]---+
//                                 [Cstack] between pd and nd (vertical n/p stack)
//
// CFET parasitics (mid-range defaults of the brief):
//   CSTACK  stacked-drain coupling capacitance    0.03f
//   COUT    output / local interconnect capacitance 0.3f
//   RLOCAL  local via / drain-to-output resistance  50 Ohm (one per device)
// The device variables are SUBCIRCUIT parameters (numeric nominal defaults) so
// that Spectre `mismatch` statistics (cadence/ade/mc_statistics.scs) sample them
// per inverter instance; the testbench passes VTHN=VTHN etc. so the global
// `process` variation of the top-level parameter is inherited as well.
// -------------------------------------------------------------------------------
subckt inv_cfet_cnt (in out vdd vss)
parameters CSTACK=0.03f COUT=0.3f RLOCAL=50 \
    Wn=100n Wp=100n Lg=15n VTHN=0.20 VTHP=0.22 DCNT=250e6 FMET=0.01 RCN=1e-4 RCP=1e-4
    MP (pd in vdd vdd) cnt_p W=Wp L=Lg VTH0=VTHP DCNT=DCNT FMET=FMET RC=RCP \
        N0=1.05 ETA=0.05 COX=0.020 TTR=0.65 ALPHA=0.60 RSW=0 RDW=0 CGSO=4e-11 CGDO=4e-11 TNOM=300 MUEXP=0 KVTH=-1e-3
    MN (nd in vss vss) cnt_n W=Wn L=Lg VTH0=VTHN DCNT=DCNT FMET=FMET RC=RCN \
        N0=1.05 ETA=0.04 COX=0.020 TTR=0.70 ALPHA=0.60 RSW=0 RDW=0 CGSO=4e-11 CGDO=4e-11 TNOM=300 MUEXP=0 KVTH=-1e-3
    Rlocal_p (pd out) resistor r=RLOCAL
    Rlocal_n (nd out) resistor r=RLOCAL
    Cstack   (pd nd)  capacitor c=CSTACK
    Cout     (out vss) capacitor c=COUT
ends inv_cfet_cnt
